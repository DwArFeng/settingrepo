<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:datamark="http://dwarfeng.com/schema/dwarfeng-datamark"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dwarfeng.com/schema/dwarfeng-datamark
        http://dwarfeng.com/schema/dwarfeng-datamark/dwarfeng-datamark.xsd"
>

    <!-- SettingCategory 数据标识。 -->
    <datamark:handler
            handler-name="settingCategoryDatamarkHandler"
            resource-url="${com.dwarfeng.settingrepo.datamark.setting_category.resource_url}"
            resource-charset="${com.dwarfeng.settingrepo.datamark.setting_category.resource_charset}"
            update-allowed="${com.dwarfeng.settingrepo.datamark.setting_category.update_allowed}"
    />

    <!-- SettingNode 数据标识。 -->
    <datamark:handler
            handler-name="settingNodeDatamarkHandler"
            resource-url="${com.dwarfeng.settingrepo.datamark.setting_node.resource_url}"
            resource-charset="${com.dwarfeng.settingrepo.datamark.setting_node.resource_charset}"
            update-allowed="${com.dwarfeng.settingrepo.datamark.setting_node.update_allowed}"
    />

    <!-- WarmupSetting 数据标识。 -->
    <datamark:handler
            handler-name="warmupSettingDatamarkHandler"
            resource-url="${com.dwarfeng.settingrepo.datamark.warmup_setting.resource_url}"
            resource-charset="${com.dwarfeng.settingrepo.datamark.warmup_setting.resource_charset}"
            update-allowed="${com.dwarfeng.settingrepo.datamark.warmup_setting.update_allowed}"
    />

    <!-- WarmupDriverInfo 数据标识。 -->
    <datamark:handler
            handler-name="warmupDriverInfoDatamarkHandler"
            resource-url="${com.dwarfeng.settingrepo.datamark.warmup_driver_info.resource_url}"
            resource-charset="${com.dwarfeng.settingrepo.datamark.warmup_driver_info.resource_charset}"
            update-allowed="${com.dwarfeng.settingrepo.datamark.warmup_driver_info.update_allowed}"
    />
</beans>
