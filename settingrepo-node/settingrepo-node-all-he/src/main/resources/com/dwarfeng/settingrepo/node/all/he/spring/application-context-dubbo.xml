<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:dubbo="http://dubbo.apache.org/schema/dubbo"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dubbo.apache.org/schema/dubbo
        http://dubbo.apache.org/schema/dubbo/dubbo.xsd"
>

    <!-- region 基础配置 -->

    <dubbo:application name="settingrepo-node-all-he">
        <dubbo:parameter key="qos.enable" value="false"/>
    </dubbo:application>

    <!-- Zookeeper 注册中心。 -->
    <dubbo:registry
            address="${com.dwarfeng.settingrepo.dubbo.registry.zookeeper.address}"
            timeout="${com.dwarfeng.settingrepo.dubbo.registry.zookeeper.timeout}"
    />

    <!-- Dubbo 协议。 -->
    <dubbo:protocol
            id="dubbo"
            name="dubbo"
            port="${com.dwarfeng.settingrepo.dubbo.protocol.dubbo.port}"
            host="${com.dwarfeng.settingrepo.dubbo.protocol.dubbo.host}"
            dispatcher="message"
            threadpool="fixed"
            threads="100"
    />
    <!-- Hessian 协议。 -->
    <dubbo:protocol
            name="hessian"
            port="${com.dwarfeng.settingrepo.dubbo.protocol.hessian.port}"
            server="jetty"
    />

    <!-- 默认使用 dubbo 协议。 -->
    <dubbo:provider protocol="dubbo"/>

    <!-- endregion -->

    <!-- region 服务配置 -->

    <!-- region settingrepo -->

    <!-- 向注册中心注册暴露服务地址，注册服务。 -->
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.FormatterSupportMaintainService"
            ref="formatterSupportMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.SettingCategoryMaintainService"
            ref="settingCategoryMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.SettingNodeMaintainService"
            ref="settingNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.SettingNodeOperateService"
            ref="settingNodeOperateServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.TextNodeMaintainService"
            ref="textNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.TextNodeOperateService"
            ref="textNodeOperateServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.ImageNodeMaintainService"
            ref="imageNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.ImageNodeOperateService"
            ref="imageNodeOperateServiceImpl"
            protocol="hessian"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.ImageListNodeMaintainService"
            ref="imageListNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.ImageListNodeOperateService"
            ref="imageListNodeOperateServiceImpl"
            protocol="hessian"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.ImageListNodeItemMaintainService"
            ref="imageListNodeItemMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.IahnNodeMaintainService"
            ref="iahnNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.IahnNodeOperateService"
            ref="iahnNodeOperateServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.IahnNodeLocaleMaintainService"
            ref="iahnNodeLocaleMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.IahnNodeMekMaintainService"
            ref="iahnNodeMekMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.IahnNodeMessageMaintainService"
            ref="iahnNodeMessageMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.LongTextNodeMaintainService"
            ref="longTextNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.LongTextNodeOperateService"
            ref="longTextNodeOperateServiceImpl"
            protocol="hessian"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.FileNodeMaintainService"
            ref="fileNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.FileNodeOperateService"
            ref="fileNodeOperateServiceImpl"
            protocol="hessian"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.FileListNodeMaintainService"
            ref="fileListNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.FileListNodeOperateService"
            ref="fileListNodeOperateServiceImpl"
            protocol="hessian"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.FileListNodeItemMaintainService"
            ref="fileListNodeItemMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.NavigationNodeMaintainService"
            ref="navigationNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.NavigationNodeOperateService"
            ref="navigationNodeOperateServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.NavigationNodeItemMaintainService"
            ref="navigationNodeItemMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />

    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.KvNodeMaintainService"
            ref="kvNodeMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />

    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.KvNodeItemMaintainService"
            ref="kvNodeItemMaintainServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />
    <dubbo:service
            interface="com.dwarfeng.settingrepo.stack.service.KvNodeOperateService"
            ref="kvNodeOperateServiceImpl"
            group="${com.dwarfeng.settingrepo.dubbo.provider.group}"
    />

    <!-- endregion -->

    <!-- endregion -->

    <!-- region 引用配置 -->

    <!-- region snowflake -->

    <!-- 向注册中心注册暴露服务地址，注册消费者服务。 -->
    <dubbo:reference
            id="snowflakeGenerateService"
            interface="com.dwarfeng.sfds.stack.service.GenerateService"
            check="false"
            group="${com.dwarfeng.settingrepo.dubbo.consumer.snowflake.group}"
    />

    <!-- endregion -->

    <!-- endregion -->
</beans>
